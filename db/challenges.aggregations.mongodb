
// Query for searching for winner details from the challenges collection by winner field to users collection

db.challenges.aggregate([
  {
    $lookup: {
      from: "users",
      let: { local_str: "$winner" }, // 1. Store the local string in a variable
      pipeline: [
        {
          $match: {
            $expr: {
              // 2. Convert the local string variable ($$local_str) to an ObjectId 
              // and compare it with the foreign ObjectId field ($_id)
              $eq: ["$_id", { $toObjectId: "$$local_str" }]
            }
          }
        }
      ],
      as: "user_details"
    }
  }
])



db.challenges.aggregate([
  // Step 1: FILTER FIRST (Reduces the dataset before joins)
  {
    $match: {
      board: "HTML"
    }
  }, 

  // Step 2: SORT NEXT (1 for ascending, -1 for descending)
  {
    $sort: {
      createdAt: -1
    }
  }, 

  // Step 3: Lookup from first collection
  {
    $lookup: {
      from: "users",
      let: { local_string_array_users: "$userId" }, // 1. Pass the array of strings as a variable
      pipeline: [
        {
          $match: {
            $expr: {
              // 2. Check if the foreign ObjectId ($_id) exists inside our converted array
              $in: [
                "$_id", 
                {
                  // 3. Map over the string array and cast every item to an ObjectId
                  $map: { input: "$$local_string_array_users", as: "str", in: { $toObjectId: "$$str" } }
                }
              ]
            }
          }
        }, 
        // Step 2: Select only the fields you want to keep
        { // Set to 0 if you want to exclude the customer _id, or 1 to keep it
          $project: { _id: 0, firstName: 1, lastName: 1 }
        }
      ],
      as: "userDetails"
    }
  }, 


  // Step 4: Lookup from second collection
  {
    $lookup: {
      from: "exams",
      let: { local_string_array_exams: "$examId" }, // 1. Pass the array of strings as a variable
      pipeline: [
        {
          $match: {
            $expr: {
              // 2. Check if the foreign ObjectId ($_id) exists inside our converted array
              $in: [
                "$_id", 
                {
                  // 3. Map over the string array and cast every item to an ObjectId
                  $map: {
                    input: "$$local_string_array_exams",
                    as: "str",
                    in: { $toObjectId: "$$str" }
                  }
                }
              ]
            }
          }
        }, 
        // Step 2: Select only the fields you want to keep
        {
          $project: {
            _id: 0, // Set to 0 if you want to exclude the customer _id, or 1 to keep it
            score: 1,
            startedAt: 1,
            completedAt: 1
          }
        }
      ],
      as: "examDetails"
    }
  }
])